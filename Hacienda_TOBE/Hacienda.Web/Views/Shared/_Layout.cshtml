<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HaciendaSoft TO-BE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root { --aw-green: #2e7d32; --aw-brown: #8b4513; }
        body { font-family: Inter, system-ui, sans-serif; background: #f7f9f7; }
        .navbar-brand { color: var(--aw-green) !important; }
        .aw-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.06); transition: transform .15s, box-shadow .15s; }
        .aw-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.1); }
        .stat-pill { display:inline-block; padding:.25rem .75rem; border-radius:999px; background:#e8f5e9; color:#1b5e20; font-weight:600; font-size:.85rem; }
    </style>
</head>
<body>
<header class="sticky-top">
<nav class="navbar navbar-expand-md navbar-light bg-white border-bottom shadow-sm py-2">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
      <span class="material-icons-outlined" style="vertical-align:middle">grass</span> HaciendaSoft
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Potrero" asp-action="Index">Potreros</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Res" asp-action="Index">Reses</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Vacuna" asp-action="Index">Vacunas</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Venta" asp-action="Index">Ventas</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item"><span class="nav-link text-muted">@User.Identity?.Name</span></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Salir</a></li>
      </ul>
    </div>
  </div>
</nav>
</header>
<div class="container py-4">
@if (TempData["Msg"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Msg"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Err"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Err"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@RenderBody()
</div>
<footer class="border-top py-3 mt-4 text-center text-muted small">
  HaciendaSoft TO-BE · Arquitectura SOLID (Domain / Application / Infrastructure / Web)
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
