@{ ViewData["Title"] = "Crear usuario"; }
<h2 class="fw-bold mb-3">Nuevo usuario</h2>
<div class="aw-card p-4" style="max-width:420px">
<form method="post" asp-action="Create">
  @Html.AntiForgeryToken()
  <div class="mb-3"><label class="form-label">Nombre</label><input name="nombre" class="form-control" required /></div>
  <div class="mb-3"><label class="form-label">Contraseña</label><input name="contrasena" type="password" class="form-control" required /></div>
  <button type="submit" class="btn btn-success">Crear</button>
  <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
</div>
