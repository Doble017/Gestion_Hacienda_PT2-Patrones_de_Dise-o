@model IReadOnlyList<Hacienda.Domain.Entities.Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="fw-bold mb-0">Usuarios</h2>
  <a class="btn btn-success" asp-action="Create">Nuevo usuario</a>
</div>
<div class="aw-card table-responsive">
<table class="table mb-0">
  <thead class="table-light"><tr><th>Nombre</th></tr></thead>
  <tbody>
  @foreach (var u in Model) {
    <tr><td>@u.Nombre</td></tr>
  }
  @if (!Model.Any()) {
    <tr><td class="text-center text-muted py-4">Sin usuarios</td></tr>
  }
  </tbody>
</table>
</div>
