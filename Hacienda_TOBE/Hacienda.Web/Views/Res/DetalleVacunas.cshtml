@model Hacienda.Domain.Entities.Res
@{ ViewData["Title"] = "Vacunas de " + Model.Nombre; }
<h2 class="fw-bold mb-1">Vacunas de @Model.Nombre</h2>
<p class="text-muted">Potrero: @ViewBag.PotreroId · Peso: @Model.Peso kg · Edad: @Model.Edad meses</p>
<div class="aw-card table-responsive">
<table class="table mb-0">
  <thead class="table-light"><tr><th>Nombre</th><th>Lote</th><th>Tipo</th><th>Aplicación</th><th>Vencimiento</th></tr></thead>
  <tbody>
  @foreach (var v in Model.VacunasAplicadas) {
    string tipo = v is Hacienda.Domain.Entities.Bacteriana ? "Bacteriana" : "Viva";
    <tr>
      <td>@v.Nombre</td><td>@v.Lote</td><td>@tipo</td>
      <td>@v.FechaAplicacion.ToString("yyyy-MM-dd")</td>
      <td>@v.FechaVencimiento.ToString("yyyy-MM-dd")</td>
    </tr>
  }
  @if (!Model.VacunasAplicadas.Any()) {
    <tr><td colspan="5" class="text-center text-muted py-4">Sin vacunas aplicadas</td></tr>
  }
  </tbody>
</table>
</div>
<div class="mt-3">
  <a class="btn btn-outline-primary" asp-controller="Vacuna" asp-action="Aplicar">Aplicar vacuna</a>
  <a class="btn btn-link" asp-action="Index">Volver a reses</a>
</div>
