@model IReadOnlyList<Hacienda.Domain.Entities.Venta>
@{ ViewData["Title"] = "Ventas"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="fw-bold mb-1">Ventas</h2>
    <span class="stat-pill">@ViewBag.TotalVentas registros</span>
    <span class="stat-pill ms-1">@string.Format("{0:C0}", ViewBag.MontoTotal)</span>
  </div>
  <a class="btn btn-success" asp-action="Create">Registrar venta</a>
</div>
<div class="aw-card table-responsive">
<table class="table table-hover mb-0">
  <thead class="table-light"><tr><th>Fecha</th><th>Potrero</th><th>Res</th><th>Tipo</th><th>Peso</th><th>Monto</th></tr></thead>
  <tbody>
  @foreach (var v in Model.OrderByDescending(x => x.Fecha)) {
    <tr>
      <td>@v.Fecha.ToString("yyyy-MM-dd")</td>
      <td>@v.PotreroId</td>
      <td class="fw-semibold">@v.NombreRes</td>
      <td>@v.TipoRes</td>
      <td>@v.PesoRes kg</td>
      <td>@v.Monto.ToString("C0")</td>
    </tr>
  }
  @if (!Model.Any()) {
    <tr><td colspan="6" class="text-center text-muted py-4">Sin ventas registradas</td></tr>
  }
  </tbody>
</table>
</div>
