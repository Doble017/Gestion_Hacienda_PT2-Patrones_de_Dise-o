@{ ViewData["Title"] = "Crear potrero"; }
<h2 class="fw-bold mb-3">Nuevo potrero</h2>
<div class="aw-card p-4" style="max-width:480px">
<form method="post" asp-action="Create">
  @Html.AntiForgeryToken()
  <div class="mb-3">
    <label class="form-label">Identificación</label>
    <input name="identificacion" class="form-control" required placeholder="Ej: Potrero Norte" />
  </div>
  <div class="mb-3">
    <label class="form-label">Tipo de ganado</label>
    <select name="tipo" class="form-select">
      <option value="Ternero">Ternero (0–12 meses)</option>
      <option value="Cebon">Cebón (13–48 meses)</option>
      <option value="Novillo">Novillo (49+ meses)</option>
    </select>
  </div>
  <button type="submit" class="btn btn-success">Crear</button>
  <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
</div>
